# Local-only Docker Compose settings. Copy to .env.docker and replace both passwords.
# This file is for local development, not production deployment.
APP_NAME="Bun ERP Template"
APP_ENV=development
APP_URL=http://localhost:3000
APP_RELEASE=local-docker
APP_TIMEZONE=UTC
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-only-change-this-secret-before-sharing
AUTH_TRUSTED_ORIGINS=http://localhost:3000

HOST_PORT=3000
POSTGRES_DB=bun_erp
POSTGRES_USER=bun_erp
POSTGRES_PASSWORD=local-only-change-this-database-password
