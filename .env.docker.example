# Local-only Docker Compose settings. Copy to .env.docker and fill in the two secrets below.
# This file is for local development, not production deployment.
APP_NAME="Loom Template"
APP_ENV=development
APP_URL=http://localhost:3000
APP_RELEASE=local-docker
APP_TIMEZONE=UTC
BETTER_AUTH_URL=http://localhost:3000
# Required. Generate one with `bun loom env:key:generate`; compose refuses to start while it is empty.
BETTER_AUTH_SECRET=
# VPS/Docker has no per-request CPU cap, so use the memory-hard scrypt. pbkdf2 is for Workers Free.
PASSWORD_HASH=scrypt
AUTH_TRUSTED_ORIGINS=http://localhost:3000

HOST_PORT=3000
POSTGRES_DB=loom
POSTGRES_USER=loom
# Required. Compose refuses to start while it is empty.
POSTGRES_PASSWORD=
