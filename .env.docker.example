# Local-only Docker Compose settings. Copy to .env.docker and fill in the two secrets below.
# This file is for local development, not production deployment.
APP_NAME="Bun ERP Template"
APP_ENV=development
APP_URL=http://localhost:3000
APP_RELEASE=local-docker
APP_TIMEZONE=UTC
BETTER_AUTH_URL=http://localhost:3000
# Required. Generate one with `bun erp env:key:generate`; compose refuses to start while it is empty.
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000

HOST_PORT=3000
POSTGRES_DB=bun_erp
POSTGRES_USER=bun_erp
# Required. Compose refuses to start while it is empty.
POSTGRES_PASSWORD=
