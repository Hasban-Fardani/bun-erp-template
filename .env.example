# Application
APP_NAME="Bun ERP Template"
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
APP_RELEASE=dev
APP_TIMEZONE=UTC

# Log: console (stdout, docker default) | daily (file, bare metal)
LOG_DRIVER=console
LOG_LEVEL=debug
# Bare production path is /var/log/bun-erp/app.log — dev default below
LOG_PATH=.data/logs/app.log
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE_MB=100
TRUST_PROXY=false

# Web: every VITE_* value is public and bundled into the client
VITE_APP_NAME="Bun ERP Template"
VITE_API_BASE_URL=/api/v1

# Database: pglite (dev/test, zero install) | postgres (production)
DATABASE_DRIVER=pglite
PGLITE_PATH=.data/pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bun_erp
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable

# Better Auth: after copying this file, run `bun erp key:generate`
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Google OAuth is dormant (ADR-0009): the provider is only registered when BOTH are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: local is development/test only; use s3 in production
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage

# Mail: log | smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Bun ERP Template"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Feature flags; add project flags to the typed registry
FEATURE_ADVANCED_REPORTS=false

# Tema UI: kertas-tenang | tinta-gelap
VITE_THEME="kertas-tenang"
