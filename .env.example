# Application
APP_NAME="Bun ERP Template"
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
APP_RELEASE=dev
APP_TIMEZONE=UTC
# Implemented production targets: bun | cloudflare. Dev always uses Bun + Vite HMR.
APP_DEPLOY_TARGET=bun
# integrated serves web assets from the API host; separate serves API only on Bun.
APP_WEB_MODE=integrated
# Public OpenAPI document (/api/openapi.json) + Scalar reference (/api/docs).
# Unset: on outside production, off in production. Set true to expose it deliberately.
API_DOCS_ENABLED=

# Log: console (stdout, docker default) | daily (file, bare metal)
LOG_DRIVER=console
LOG_LEVEL=debug
# Bare production path is /var/log/bun-erp/app.log — dev default below
LOG_PATH=.data/logs/app.log
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE_MB=100
# Set true only behind a reverse proxy; the auth layer then trusts x-forwarded-for for rate limiting.
TRUST_PROXY=false

# Web: every VITE_* value is public and bundled into the client
VITE_APP_NAME="Bun ERP Template"
VITE_API_BASE_URL=

# Server persistence always uses PostgreSQL; mobile SQLite is a separate offline store.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bun_erp
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable

# Better Auth: after copying this file, run `bun erp key:generate`
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Password hash for NEW passwords: pbkdf2 (default) | scrypt.
# pbkdf2 (Web Crypto, PBKDF2-HMAC-SHA256) is the default because one sign-in costs ~2-4 ms CPU, which fits
# Cloudflare Workers Free (10 ms per request). On a VPS/Bun host with no CPU cap, scrypt (memory-hard,
# ~110 ms CPU per sign-in) is the stronger choice. Switching is safe: stored hashes are self-describing,
# so existing hashes of either kind keep verifying; a user moves to the new algorithm on the next
# password change. scrypt on production Cloudflare needs Workers Paid (preflight enforces cpu_ms).
PASSWORD_HASH=pbkdf2
# pbkdf2 only, 1000-100000. Cloudflare workerd rejects more than 100000, so the cap holds everywhere.
PASSWORD_HASH_ITERATIONS=30000
# Public email/password self sign-up. Off by default: create accounts with `bun erp user:create`.
AUTH_SIGNUP_ENABLED=false
# Better Auth rate limiting; the auth endpoints keep their stricter built-in rules.
AUTH_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
# User impersonation (docs/security.md): false disables the start endpoint; sessions last at most the TTL.
IMPERSONATION_ENABLED=true
IMPERSONATION_TTL_MINUTES=60
# Per-process permission cache. On for single-process dev; set false for Workers/multi-replica
# deployments, where an invalidation only reaches the process that handled the write (docs/security.md).
PERMISSION_CACHE_ENABLED=true
# Cache facade: memory (per process) | database (shared, table cache_entries) | cloudflare-kv (Worker binding,
# eventually consistent). Permissions never use cloudflare-kv.
CACHE_DRIVER=memory
CACHE_KV_BINDING=CACHE_KV
# Google sign-in: set BOTH to show "Continue with Google" on the login screen. Authorized redirect URI in
# Google Cloud Console: <APP_URL>/api/v1/auth/callback/google. Only accounts created with
# `bun erp user:create` (or self sign-up when AUTH_SIGNUP_ENABLED=true) can sign in; a Google account
# with the same email links to its user. Google sign-in costs no password hashing, so it is the
# lightest option on Cloudflare Workers Free.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email/password sign-in. false = Google-only (needs both GOOGLE_* keys above); `user:create` then
# needs no password.
AUTH_PASSWORD_ENABLED=true

# Storage: local is development/test only. s3 uses Bun.S3Client; r2 uses a Cloudflare Worker binding.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage
# Public base for object URLs (required by r2; empty falls back to presigned URLs on s3)
STORAGE_PUBLIC_URL=
# Worker binding name for the r2 driver
STORAGE_R2_BINDING=STORAGE
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Mail driver: log | smtp | http (memory is registry/test-only, not a MAIL_DRIVER value). smtp is refused on
# Cloudflare Workers; use http (Resend over fetch) there. http requires MAIL_API_KEY (secret).
# The keys are dormant until `bun erp features:install mail` installs the @bun-erp/mail transport.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Bun ERP Template"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_HTTP_PROVIDER=resend
MAIL_API_KEY=

# AI assistant (docs/ai.md); every signed-in role with ai.use sees "Ask AI".
# workers-ai (default): the Worker's AI binding on Cloudflare, nothing to set. On Bun/VPS it calls the
#   same models over REST; set AI_ACCOUNT_ID + AI_API_KEY (an API token with "Workers AI: Read").
# openai: any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama); set AI_BASE_URL, AI_API_KEY, AI_MODEL.
# fake: offline echo for local work without keys; off: the panel says the assistant is not set up.
AI_DRIVER=workers-ai
# Empty = @cf/meta/llama-3.1-8b-instruct-fast on Workers AI.
AI_MODEL=
AI_ACCOUNT_ID=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=768
# Questions per user per UTC day; keeps a demo inside the Workers Free AI allowance.
AI_DAILY_LIMIT=50
# What a conversation keeps: full (every turn), summary (title + short rolling summary) or off (nothing).
AI_HISTORY=full
# Read-only tools the assistant may call (notifications, user lookup); each question runs at most
# AI_MAX_TOOL_CALLS of them. false skips the planning step and costs no extra model call.
AI_TOOLS_ENABLED=true
AI_MAX_TOOL_CALLS=3
# Function-calling model for the planning step only. Empty = @hf/nousresearch/hermes-2-pro-mistral-7b
# on Workers AI, or AI_MODEL on openai.
AI_TOOL_MODEL=

# Feature flags; add project flags to the typed registry
FEATURE_ADVANCED_REPORTS=false

# UI palette: light | dark
VITE_THEME="light"

# Native packaging identity; set in the copied application, not the template
MOBILE_APP_ID=
MOBILE_APP_NAME=
# mobile:build requires an absolute HTTPS VITE_API_BASE_URL (API origin only)
