{
  "$comment": "Defines the boundary between reusable template files and deployment-specific files. Enforced by `bun loom check:scope`.",
  "version": 1,
  "template": {
    "name": "loom-template",
    "license": "MIT"
  },
  "allowed": {
    "topLevelDirs": [
      "apps",
      "cli",
      "docs",
      "skills",
      "templates",
      ".githooks",
      ".github",
      ".agents",
      ".claude",
      "packages"
    ],
    "apps": [],
    "note": "Deployment-specific business features stay out of this template. The template contains reusable foundations and reference features. apps/ ships empty; app catalogs live in templates/apps and are installed by `bun loom init`."
  },
  "forbidden": {
    "paths": [".env", ".env.local", ".env.production", ".data"],
    "patterns": [
      {
        "id": "client-name",
        "regex": "\\b(flora|idar|danari|daness|hasban)\\b",
        "reason": "Nama client/owner tidak boleh bocor ke repo template publik",
        "allowIn": ["docs/tasks/**", "*.local", ".gitignore", "LICENSE", "template.scope.json"],
        "flags": "i"
      },
      {
        "id": "business-domain",
        "regex": "\\b(payroll|absensi|attendance|procurement|inventory-stock|pos-cashier)\\b",
        "reason": "Aturan bisnis client dibuat dari product spec terpisah (PRD \u00a72 non-goals)",
        "allowIn": ["docs/**", "README.md", "AGENTS.md", "template.scope.json"],
        "flags": "i"
      }
    ]
  },
  "featureReferenceExample": "templates/apps/server/features/identity",
  "coreFeatures": [
    "templates/apps/server/features/identity",
    "templates/apps/server/features/rbac",
    "templates/apps/server/features/audit"
  ],
  "featureSecondaryExamples": ["templates/features/departments"]
}
