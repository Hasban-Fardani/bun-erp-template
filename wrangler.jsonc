{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bun-erp-template",
  "main": "apps/server/bootstrap/cloudflare-entry.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  // Production needs Workers Paid: password sign-in costs ~110 ms CPU and Workers Free allows 10 ms.
  // Paid defaults to 30 s; the preflight requires at least 200 ms and this keeps a runaway bounded.
  "limits": { "cpu_ms": 500 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  // Private object storage for STORAGE_DRIVER=r2 (docs/deployment.md, "Object storage").
  // Create the bucket first: bun run --cwd apps/web wrangler r2 bucket create bun-erp-template-files
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "bun-erp-template-files" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  // Queue wake-up for Workers (docs/deployment.md, "Jobs on Workers"). The database stays the
  // outbox: these signals only reduce latency, and a lost message delays a job to the next sweep.
  // To enable on a Queues-enabled account:
  //   1. bun run --cwd apps/web wrangler queues create bun-erp-template-jobs
  //   2. set "JOBS_WAKEUP_DRIVER": "cloudflare-queue" in vars below
  //   3. uncomment this block, then run bun erp cloudflare:build
  // Accounts without Queues keep working on the cron sweeper alone (driver "none").
  // "queues": {
  //   "producers": [{ "binding": "JOBS_QUEUE", "queue": "bun-erp-template-jobs" }],
  //   "consumers": [
  //     {
  //       "queue": "bun-erp-template-jobs",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5,
  //       "max_retries": 5
  //     }
  //   ]
  // },
  "vars": {
    "APP_NAME": "Bun ERP Template",
    "APP_ENV": "production",
    "APP_URL": "https://bun-erp-template.example.workers.dev",
    "APP_PORT": "8787",
    "APP_RELEASE": "0.1.0",
    "APP_TIMEZONE": "UTC",
    "APP_DEPLOY_TARGET": "cloudflare",
    "APP_WEB_MODE": "integrated",
    "LOG_DRIVER": "console",
    "LOG_LEVEL": "info",
    "LOG_PATH": "stdout",
    "LOG_RETENTION_DAYS": "30",
    "LOG_MAX_SIZE_MB": "50",
    "TRUST_PROXY": "true",
    "DATABASE_DRIVER": "postgres",
    "DATABASE_POOL_MAX": "5",
    "DATABASE_SSL_MODE": "require",
    "BETTER_AUTH_URL": "https://bun-erp-template.example.workers.dev",
    "AUTH_TRUSTED_ORIGINS": "https://bun-erp-template.example.workers.dev",
    "PERMISSION_CACHE_ENABLED": "false",
    "STORAGE_DRIVER": "r2",
    "STORAGE_LOCAL_ROOT": ".data/storage",
    "STORAGE_PUBLIC_URL": "https://bun-erp-template.example.workers.dev/api/v1/files",
    "STORAGE_R2_BINDING": "STORAGE",
    "MAIL_DRIVER": "log",
    "MAIL_FROM_ADDRESS": "no-reply@example.test",
    "MAIL_FROM_NAME": "Bun ERP Template",
    "JOBS_WAKEUP_DRIVER": "none",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "SMTP_USERNAME": "",
    "FEATURE_ADVANCED_REPORTS": "false"
  }
}
