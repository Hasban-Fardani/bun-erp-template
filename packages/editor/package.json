{
  "name": "@bun-erp/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible, composable rich text editor components for Bun ERP applications",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./client": {
      "types": "./src/client.tsx",
      "import": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "bun test tests"
  },
  "dependencies": {
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "lexical": "0.52.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7"
  }
}
