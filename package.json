{
  "name": "loom-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/utils",
    "packages/storage",
    "packages/i18n"
  ],
  "scripts": {
    "loom": "bun cli/index.ts",
    "prepare": "bun cli/tasks/install-git-hooks.ts",
    "dev": "bun loom dev",
    "build": "bun loom build",
    "start": "bun apps/server/bootstrap/server.ts",
    "lint": "bunx --bun biome check .",
    "check:biome": "bunx --bun biome check .",
    "format": "bunx --bun biome format --write .",
    "format:check": "bunx --bun biome format .",
    "check": "bun loom check",
    "check:fast": "bun loom check:fast",
    "check:prod": "bun loom check:prod",
    "install:prod": "bun install --production",
    "test": "bun loom test",
    "qa": "bun loom qa"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "playwright-core": "1.63.0",
    "react-doctor": "0.9.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
