{
  "name": "bun-erp-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/ui",
    "packages/utils",
    "packages/storage",
    "packages/i18n"
  ],
  "scripts": {
    "erp": "bun cli/index.ts",
    "prepare": "bun cli/tasks/install-git-hooks.ts",
    "dev": "bun erp dev",
    "build": "bun erp build",
    "start": "bun apps/server/bootstrap/server.ts",
    "lint": "bunx --bun biome check .",
    "check:biome": "bunx --bun biome check .",
    "format": "bunx --bun biome format --write .",
    "format:check": "bunx --bun biome format .",
    "check": "bun erp check",
    "check:fast": "bun erp check:fast",
    "check:prod": "bun erp check:prod",
    "install:prod": "bun install --production",
    "test": "bun erp test",
    "qa": "bun erp qa"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "playwright-core": "1.63.0",
    "react-doctor": "0.9.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
